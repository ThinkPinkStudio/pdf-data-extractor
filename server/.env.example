# ── Server ──────────────────────────────────────────────────────────
PORT=3000
MCP_PORT=3001
NODE_ENV=production
BASE_URL=https://tuodominio.example.com

# ── Database PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql://appuser:password@localhost:5432/pdf_extractor

# ── Auth ─────────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=azienda.it
# Genera: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAGIC_LINK_SECRET=cambia-questo-con-valore-casuale-almeno-16-char
MAGIC_LINK_EXPIRY_MINUTES=15

# ── Sessione ─────────────────────────────────────────────────────────
# Genera: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-questo-con-valore-casuale-almeno-32-char
SESSION_MAX_AGE_HOURS=8

# ── Email (Resend) ────────────────────────────────────────────────────
# Ottieni la chiave su https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@azienda.it

# ── IP allowlist (virgola-separati, supporta CIDR es. 192.168.1.0/24) ─
API_ALLOWED_IPS=127.0.0.1,::1
MCP_ALLOWED_IPS=127.0.0.1,::1

# ── LLM ──────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama          # ollama | openai | anthropic
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Queue bearer token (per software scanner futuro, min 32 char) ─────
# QUEUE_BEARER_TOKEN=

# ── Percorsi ─────────────────────────────────────────────────────────
LOG_DIR=./data/logs
UPLOAD_DIR=./data/uploads
