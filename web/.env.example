# ─── SMTP ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="PDF Extractor <noreply@example.com>"

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# URL base dell'app (usato nei magic link)
MAGIC_LINK_BASE_URL=https://app.example.com
# Minuti di validità del magic link
MAGIC_LINK_EXPIRY_MINUTES=15
# Segreto per cifrare i cookie di sessione (min 32 caratteri, cambia questo!)
SESSION_SECRET=change-me-to-a-random-32-char-secret!!
# Durata sessione in secondi (default: 7 giorni)
SESSION_MAX_AGE_SECONDS=604800
# Email autorizzate ad accedere, separate da virgola. Usa * per permettere tutti.
ALLOWED_EMAILS=user@example.com,admin@example.com
# Email con accesso ai log (default: stesse di ALLOWED_EMAILS)
ADMIN_EMAILS=admin@example.com

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Percorso del database SQLite (dentro il container)
DATABASE_PATH=/data/app.db

# ─── LLM (opzionale - configurabile anche dalla UI) ──────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3
# OLLAMA_URL=http://ollama:11434
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
