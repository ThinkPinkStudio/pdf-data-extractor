# ─── SMTP ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="PDF Extractor <noreply@example.com>"

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# URL base dell'app (usato nei magic link)
MAGIC_LINK_BASE_URL=https://app.example.com
# Minuti di validità del magic link
MAGIC_LINK_EXPIRY_MINUTES=15
# Segreto per cifrare i cookie di sessione (min 32 caratteri, cambia questo!)
SESSION_SECRET=change-me-to-a-random-32-char-secret!!
# Durata sessione in secondi (default: 7 giorni)
SESSION_MAX_AGE_SECONDS=604800
# Domini email autorizzati ad accedere, separati da virgola. Usa * per permettere tutti.
ALLOWED_DOMAINS=azienda.it,partner.com
# Email con accesso ai log (default: nessun filtro se non specificato)
ADMIN_EMAILS=admin@azienda.it

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Connection string PostgreSQL
DATABASE_URL=postgresql://pguser:pgpass@localhost:5432/pdfextractor

# ─── LLM (opzionale - configurabile anche dalla UI) ──────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3
# OLLAMA_URL=http://ollama:11434
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── EXTRACT JOBS API (batch) ────────────────────────────────────────────────
# Token di servizio per le chiamate macchina-a-macchina dell'orchestratore batch
# verso /api/extract-jobs. Obbligatorio: senza, l'API nega ogni richiesta.
EXTRACT_SERVICE_TOKEN=change-me-to-a-long-random-token
# TTL (ms) dei job conclusi in memoria prima dell'eviction (default 10 min)
EXTRACT_JOB_TTL_MS=600000

# ─── ESTRAZIONE POLIZZA (motore reale, identico all'app) ─────────────────────
# Chiave Anthropic per l'estrazione (oppure impostala nella pagina Impostazioni).
ANTHROPIC_API_KEY=sk-ant-...
# Cartella che contiene ita.traineddata (per OCR Tesseract 100% offline).
# Es. la root del repo. Se non impostata, Tesseract scarica il modello dal CDN.
APP_ROOT=/app
# true = OCR di tutte le pagine → testo → 1 chiamata (default); false = vision rolling
POLIZZA_WHOLE_DOSSIER=true
# OCR Tesseract attivo (richiesto dalla modalità fascicolo intero)
POLIZZA_OCR_ENABLED=true
# Modello Anthropic (default claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
