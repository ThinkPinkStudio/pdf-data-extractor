# ─── EMAIL ───────────────────────────────────────────────────────────────────
# Opzione A (consigliata su server VPN): Resend via HTTP API — solo HTTPS in
# uscita, nessun SMTP da gestire. Se RESEND_API_KEY è impostata, ha la precedenza
# sulla config SMTP. `SMTP_FROM` deve usare un dominio verificato su Resend
# (oppure "onboarding@resend.dev" per i test).
RESEND_API_KEY=
SMTP_FROM="PDF Extractor <noreply@example.com>"

# Opzione B: SMTP classico (usato solo se RESEND_API_KEY è vuota).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# URL base dell'app (usato nei magic link). DEVE combaciare con come gli utenti
# raggiungono l'app dal browser. Deploy solo-IP in HTTP: http://<IP>:<porta>
MAGIC_LINK_BASE_URL=https://app.example.com
# Minuti di validità del magic link
MAGIC_LINK_EXPIRY_MINUTES=15
# Segreto per cifrare i cookie di sessione (min 32 caratteri, cambia questo!)
SESSION_SECRET=change-me-to-a-random-32-char-secret!!
# Durata sessione in secondi (default: 7 giorni)
SESSION_MAX_AGE_SECONDS=604800
# Flag Secure sul cookie di sessione.
#   - Dietro reverse proxy HTTPS: "true" (o lascia vuoto → true in produzione).
#   - Deploy raggiungibile solo via IP/VPN in HTTP puro (senza TLS): "false",
#     altrimenti il browser scarta il cookie e il login entra in loop.
COOKIE_SECURE=true
# Domini email autorizzati ad accedere, separati da virgola. Usa * per permettere tutti.
ALLOWED_DOMAINS=azienda.it,partner.com
# Email con accesso ai log (default: nessun filtro se non specificato)
ADMIN_EMAILS=admin@azienda.it

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Connection string PostgreSQL (obbligatoria: initDb() gira al boot).
DATABASE_URL=postgresql://pguser:pgpass@localhost:5432/pdfextractor

# ─── LLM (opzionale - configurabile anche dalla UI) ──────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3
# OLLAMA_URL=http://ollama:11434
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
