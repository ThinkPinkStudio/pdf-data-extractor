# ─── EMAIL ───────────────────────────────────────────────────────────────────
# Opzione A (consigliata su server VPN): Resend via HTTP API — solo HTTPS in
# uscita, nessun SMTP da gestire. Se RESEND_API_KEY è impostata, ha la precedenza
# sulla config SMTP. `SMTP_FROM` deve usare un dominio verificato su Resend
# (oppure "onboarding@resend.dev" per i test).
RESEND_API_KEY=
SMTP_FROM="PDF Extractor <noreply@example.com>"

# Opzione B: SMTP classico (usato solo se RESEND_API_KEY è vuota).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# URL base dell'app (usato nei magic link). DEVE combaciare con come gli utenti
# raggiungono l'app dal browser. Deploy solo-IP in HTTP: http://<IP>:<porta>
MAGIC_LINK_BASE_URL=https://app.example.com
# Minuti di validità del magic link
MAGIC_LINK_EXPIRY_MINUTES=15
# Segreto per cifrare i cookie di sessione (min 32 caratteri, cambia questo!)
SESSION_SECRET=change-me-to-a-random-32-char-secret!!
# Durata sessione in secondi (default: 7 giorni)
SESSION_MAX_AGE_SECONDS=604800
# Flag Secure sul cookie di sessione.
#   - Dietro reverse proxy HTTPS: "true" (o lascia vuoto → true in produzione).
#   - Deploy raggiungibile solo via IP/VPN in HTTP puro (senza TLS): "false",
#     altrimenti il browser scarta il cookie e il login entra in loop.
COOKIE_SECURE=true
# Domini email autorizzati ad accedere, separati da virgola. Usa * per permettere tutti.
ALLOWED_DOMAINS=azienda.it,partner.com
# Email con accesso ai log (default: nessun filtro se non specificato)
ADMIN_EMAILS=admin@azienda.it

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Connection string PostgreSQL (obbligatoria: initDb() gira al boot).
DATABASE_URL=postgresql://pguser:pgpass@localhost:5432/pdfextractor

# ─── INDICE VETTORIALE (Qdrant + embeddings Ollama) — opzionale ────────────────
# Serve alla ricerca semantica dell'Archivio: il BATCH/estrazione polizze
# indicizza automaticamente ogni dossier su Qdrant quando questo URL è impostato
# (passo additivo e non fatale). Nel deploy Dockerfile-only su Coolify va
# impostata a mano; il valore salvato in Impostazioni vince comunque sull'env.
# QDRANT_URL=http://qdrant:6333
# La collezione (default "documenti") si imposta da Impostazioni.
# NB: gli embedding li calcola OLLAMA, non Qdrant. Il modello di embedding
# (default "bge-m3", configurabile in Impostazioni → embeddingModel) va scaricato
# nel container Ollama:  ollama pull bge-m3
# Cambiando modello di embedding la collezione Qdrant va ricreata (dimensione
# dei vettori diversa).

# ─── LLM (opzionale - configurabile anche dalla UI) ──────────────────────────
# Riguarda SOLO la sezione "PDF Extractor" (Portafoglio Compare e CSA Adesioni
# non usano alcun LLM). I modelli vanno prima scaricati nel container Ollama:
#   ollama pull llama3.1 && ollama pull llama3.2-vision   (opz. bge-m3 per l'Archivio)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_URL=http://ollama:11434
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── CSA Adesioni (sezione separata) — opzionali, configurabili anche dalla UI ─
# Notifiche email di riepilogo su esportazione/upload FTP (riusa la config SMTP sopra).
# EXPORT_NOTIFY_MODE=user            # user | shared | both
# EXPORT_NOTIFY_SHARED=ufficio@azienda.it
# Profili FTP/SFTP di pubblicazione (staging e produzione). Default precaricati,
# comunque modificabili nelle Configurazioni della sezione Adesioni.
# FTP_STAGING_PROTOCOL=ftp           # ftp | ftps | sftp
# FTP_STAGING_HOST=
# FTP_STAGING_PORT=21
# FTP_STAGING_USER=
# FTP_STAGING_PASS=
# FTP_STAGING_DIR=/upload
# FTP_PROD_PROTOCOL=sftp
# FTP_PROD_HOST=
# FTP_PROD_PORT=22
# FTP_PROD_USER=
# FTP_PROD_PASS=
# FTP_PROD_DIR=/upload
# FTP_PROD_KEY=                      # chiave privata OpenSSH/PEM per SFTP
# FTP_PROD_PASSPHRASE=

# ─── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
